<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <meta name="description" content="Free, fast and fully responsive online image compression tool. Optimize JPEG and PNG images by adjusting compression level. Reduce file size while maintaining quality. SEO friendly and mobile ready.">
  <meta name="keywords" content="image compressor, compress images online, reduce image size, JPEG optimizer, PNG compressor, free image tool">
  <meta name="author" content="ImageOptimizer">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://www.yourdomain.com/image-compressor">
  <title>Smart Image Compressor | Optimize & Reduce Image Size Online</title>
  <!-- Open Graph / Social Media -->
  <meta property="og:title" content="Smart Image Compressor - Reduce Image Size Instantly">
  <meta property="og:description" content="Drag, drop or select images. Adjust compression level and download optimized images. Fast, private, and free.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://www.yourdomain.com/og-compressor.jpg">
