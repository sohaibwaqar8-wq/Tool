<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>SmartImage Compressor | Optimize & Compress Images Online</title>
  <meta name="description" content="Free professional image compression tool with adjustable quality level. Reduce image size while preserving visual clarity. Fast, private, fully client-side.">
  <meta name="keywords" content="image compressor, compress jpeg, compress png, webp optimizer, reduce image size, online image tool">
  <meta name="author" content="SmartImage Tools">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://www.smartimagecompressor.com/">
  <!-- Open Graph / Social -->
  <meta property="og:title" content="SmartImage Compressor - Dynamic Image Optimization">
  <meta property="og:description" content="Adjust compression level, preview results, and download optimized images. Works with JPEG, PNG, WebP.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://via.placeholder.com/1200x630?text=Image+Compressor">
  <meta name="twitter:card" content="summary_large_image">
  <!-- Performance hint: preconnect for Google Fonts & Ads (optional non-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      background: #f6f9fc;
      color: #1a2c3e;
      line-height: 1.5;
      padding: 24px 20px 60px;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
    }

    /* Header & SEO friendly */
    h1 {
      font-size: 2rem;
      font-weight: 700;
      background: linear-gradient(135deg, #1e3c72, #2b4c7c);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      letter-spacing: -0.01em;
    }

    .subhead {
      color: #2c5a7a;
      border-left: 4px solid #2c7da0;
      padding-left: 16px;
      margin-top: 8px;
    }

    /* two column layout: main content + ad sidebar */
    .main-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
      margin: 32px 0 40px;
    }

    .tool-area {
      flex: 3;
      min-width: 260px;
      background: white;
      border-radius: 32px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.05);
      padding: 28px 24px;
      transition: all 0.2s ease;
    }

    .ad-sidebar {
      flex: 1.2;
      min-width: 260px;
      background: #ffffffdd;
      backdrop-filter: blur(2px);
      border-radius: 28px;
      padding: 18px 16px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.02);
      border: 1px solid #e2edf2;
    }

    .ad-container {
      background: #f3f8fb;
      border-radius: 20px;
      padding: 16px 12px;
      text-align: center;
      transition: all 0.2s;
      border: 1px dashed #bdd4e2;
      min-height: 280px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .ad-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #6f8faa;
      margin-bottom: 12px;
      font-weight: 500;
    }

    .ad-placeholder-code {
      background: #eef3f7;
      padding: 14px;
      border-radius: 14px;
      font-family: monospace;
      font-size: 12px;
      color: #1e4663;
    }

    .file-zone {
      border: 2px dashed #b9d3e8;
      border-radius: 28px;
      padding: 32px 20px;
      text-align: center;
      background: #fefefe;
      transition: 0.2s;
      cursor: pointer;
    }

    .file-zone:hover {
      border-color: #2c7da0;
      background: #fafeff;
    }

    input[type="file"] {
      display: none;
    }

    .btn-primary {
      background: #1e5a7d;
      color: white;
      border: none;
      padding: 12px 28px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .btn-primary:hover {
      background: #0f4562;
      transform: translateY(-1px);
    }

    .btn-download {
      background: #2c7a47;
    }
    .btn-download:hover {
      background: #1e5f38;
    }

    .quality-slider {
      margin: 24px 0 18px;
    }

    .slider-label {
      display: flex;
      justify-content: space-between;
      font-weight: 600;
      margin-bottom: 8px;
    }

    input[type="range"] {
      width: 100%;
      height: 6px;
      -webkit-appearance: none;
      background: #dbe9f0;
      border-radius: 10px;
      outline: none;
    }

    input[type="range"]:focus {
      outline: none;
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 20px;
      height: 20px;
      background: #1e5a7d;
      border-radius: 50%;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }

    .compress-value {
      background: #eef2f5;
      padding: 6px 12px;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .preview-area {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      margin: 28px 0 20px;
      justify-content: center;
    }

    .preview-card {
      flex: 1;
      min-width: 180px;
      background: #f9fbfd;
      border-radius: 24px;
      padding: 16px;
      text-align: center;
      border: 1px solid #e5edf2;
    }

    .preview-img {
      max-width: 100%;
      max-height: 200px;
      object-fit: contain;
      border-radius: 14px;
      background: #f0f4f7;
    }

    .info-text {
      font-size: 13px;
      color: #2c697e;
      margin-top: 8px;
      word-break: break-word;
    }

    .size-badge {
      background: #e2eef5;
      border-radius: 28px;
      padding: 4px 12px;
      display: inline-block;
      font-size: 13px;
      font-weight: 500;
    }

    hr {
      margin: 28px 0 16px;
      border: none;
      height: 1px;
      background: linear-gradient(to right, #cde0e8, transparent);
    }

    footer {
      text-align: center;
      font-size: 0.85rem;
      color: #5c7f94;
      margin-top: 40px;
      border-top: 1px solid #dce9f0;
      padding-top: 28px;
    }

    @media (max-width: 780px) {
      body {
        padding: 16px;
      }
      .tool-area, .ad-sidebar {
        flex: 1 1 100%;
      }
      h1 {
        font-size: 1.65rem;
      }
    }
  </style>
  <!-- Google AdSense will be dynamically injected via ID. Ad slots prepared -->
</head>
<body>
<div class="container">
  <header>
    <h1>⚡ SmartImage Compressor</h1>
    <p class="subhead">Lossy & lossless-inspired compression • Adjust quality • Client-side & private</p>
  </header>

  <div class="main-grid">
    <!-- MAIN TOOL SECTION -->
    <div class="tool-area">
      <div class="file-zone" id="uploadZone">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#2c7da0" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 12px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <p style="font-weight: 500;">Click or drag & drop image</p>
        <p style="font-size: 13px; color: #5685a3;">JPEG, PNG, WebP (max 16MB)</p>
        <input type="file" id="fileInput" accept="image/jpeg,image/png,image/webp">
      </div>

      <!-- Compression level slider -->
      <div class="quality-slider">
        <div class="slider-label">
          <span>🎛️ Compression level</span>
          <span class="compress-value" id="qualityValue">85%</span>
        </div>
        <input type="range" id="qualitySlider" min="10" max="100" value="85" step="1">
        <div style="display: flex; justify-content: space-between; font-size:12px; color:#5c819b; margin-top: 6px;">
          <span>⬇️ Smaller file (lower quality)</span>
          <span>⬆️ Best quality (larger file)</span>
        </div>
        <p style="font-size: 12px; margin-top: 12px; background:#eef4f8; padding:6px 12px; border-radius:28px;">
          💡 Higher compression = more size reduction. Works best with JPEG & WebP.
        </p>
      </div>

      <!-- Preview & results -->
      <div id="previewContainer" class="preview-area" style="display: none;">
        <div class="preview-card">
          <strong>📸 Original</strong>
          <img id="originalPreview" class="preview-img" alt="Original preview">
          <div class="info-text"><span id="originalSize">—</span></div>
        </div>
        <div class="preview-card">
          <strong>✨ Compressed</strong>
          <img id="compressedPreview" class="preview-img" alt="Compressed preview">
          <div class="info-text"><span id="compressedSize">—</span> &nbsp;|&nbsp; <span id="savingRatio">—</span></div>
          <button id="downloadBtn" class="btn-primary btn-download" style="margin-top: 12px; font-size:0.85rem; padding: 8px 18px;">💾 Download Compressed</button>
        </div>
      </div>
      
      <div id="noImageMessage" style="text-align:center; padding: 28px 0; color:#6c98b3;">
        ⬆ Upload an image to start compression
      </div>
    </div>

    <!-- ADS SIDEBAR: designated space for AdSense unit -->
    <div class="ad-sidebar">
      <div class="ad-container" id="googleAdSlot">
        <div class="ad-label">— Advertisement —</div>
        <!-- AdSense code insertion point: replace with your Ad Unit ID easily -->
        <div id="adsenseTarget" style="width: 100%; min-height: 250px; display: flex; align-items: center; justify-content: center; flex-direction: column;">
          <div style="background: #e9f0f5; border-radius: 16px; padding: 20px; text-align: center; width: 100%;">
            <div style="font-weight: 500; margin-bottom: 8px;">📢 Ad Space</div>
            <div style="font-size: 12px; color: #236b8e;">Insert your AdSense unit ID below</div>
            <div style="margin-top: 12px;">
              <input type="text" id="adsenseIdInput" placeholder="ca-pub-XXXXXXXXXXXXXX" style="padding: 8px 12px; border-radius: 28px; border:1px solid #cbdfe9; width: 100%; max-width: 220px; font-size:12px;">
              <button id="applyAdBtn" style="margin-top: 8px; background: #1e5a7d; border:none; color:white; border-radius: 40px; padding: 5px 12px; font-size:12px; cursor:pointer;">Apply Ad Unit</button>
            </div>
            <div id="adDebugNote" style="font-size: 10px; margin-top: 10px; color:#347a54;"></div>
          </div>
        </div>
        <!-- This container will host actual AdSense script when ID provided -->
        <div id="dynamicAdHolder" style="margin-top: 12px;"></div>
        <div class="ad-placeholder-code" style="margin-top: 15px;">
          💰 Monetize: replace with your AdSense unit ID above. <br> Google AdSense ready.
        </div>
      </div>
    </div>
  </div>

  <footer>
    <p>⚙️ Fully client-side compression – your images never leave your device. Supports JPEG, PNG, WebP. Optimized for SEO & performance.</p>
    <p style="margin-top: 8px;">© SmartImage Compressor — Reduce image file size without losing essential quality.</p>
  </footer>
</div>

<script>
  (function() {
    // DOM elements
    const fileInput = document.getElementById('fileInput');
    const uploadZone = document.getElementById('uploadZone');
    const qualitySlider = document.getElementById('qualitySlider');
    const qualityValueSpan = document.getElementById('qualityValue');
    const previewContainer = document.getElementById('previewContainer');
    const noImageMessage = document.getElementById('noImageMessage');
    const originalPreview = document.getElementById('originalPreview');
    const compressedPreview = document.getElementById('compressedPreview');
    const originalSizeSpan = document.getElementById('originalSize');
    const compressedSizeSpan = document.getElementById('compressedSize');
    const savingRatioSpan = document.getElementById('savingRatio');
    const downloadBtn = document.getElementById('downloadBtn');

    // state
    let currentOriginalFile = null;
    let currentCompressedBlob = null;
    let currentCompressedURL = null;
    let originalImageURL = null;

    // update compression label
    function updateQualityLabel(value) {
      qualityValueSpan.innerText = value + '%';
    }

    qualitySlider.addEventListener('input', (e) => {
      const val = e.target.value;
      updateQualityLabel(val);
      if (currentOriginalFile) {
        compressAndPreview(currentOriginalFile, parseInt(val));
      }
    });

    // handle file selection
    function handleFile(file) {
      if (!file) return;
      if (!file.type.match('image/jpeg') && !file.type.match('image/png') && !file.type.match('image/webp')) {
        alert('Unsupported format. Please upload JPEG, PNG, or WebP.');
        return;
      }
      if (file.size > 16 * 1024 * 1024) {
        alert('File too large (max 16MB).');
        return;
      }
      currentOriginalFile = file;
      // Show original preview
      if (originalImageURL) URL.revokeObjectURL(originalImageURL);
      originalImageURL = URL.createObjectURL(file);
      originalPreview.src = originalImageURL;
      originalSizeSpan.innerText = formatBytes(file.size);
      
      // compress with current quality
      compressAndPreview(file, parseInt(qualitySlider.value));
    }

    // compression engine using canvas
    function compressAndPreview(file, qualityPercent) {
      // qualityPercent: 0-100 -> map to 0-1 for canvas
      const qualityRatio = qualityPercent / 100;
      const img = new Image();
      const objectUrl = URL.createObjectURL(file);
      img.onload = function() {
        URL.revokeObjectURL(objectUrl);
        const canvas = document.createElement('canvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, img.width, img.height);
        
        let mimeType = file.type;
        // For PNG we also respect quality but canvas lossy compression might not be perfect: but we force JPEG if high compression? Better keep same mime but with PNG using png quality is ignored in toBlob (PNG lossless). To achieve size reduction on PNG, we convert to JPEG or WebP based on slider + original mime.
        // Strategy: For better UX: if file is PNG and quality < 95% we convert to WebP (if supported) or JPEG to reduce size significantly; but we keep transparency? we'll preserve transparency if PNG -> PNG but quality won't compress. So we offer dynamic: PNG -> WebP/JPEG based on quality threshold.
        // Actually best robust: compress to same mime if jpeg; for png use webp when quality less than 95 for compression. Let's implement smart:
        let outputMime = file.type;
        if (file.type === 'image/png') {
          // if quality <= 90% output webp (better compression) else keep png (transparency)
          if (qualityPercent <= 90 && typeof canvas.toBlob === 'function') {
            outputMime = 'image/webp';
          } else {
            outputMime = 'image/png';
          }
        } else if (file.type === 'image/jpeg') {
          outputMime = 'image/jpeg';
        } else if (file.type === 'image/webp') {
          outputMime = 'image/webp';
        }
        
        // fallback if webp not supported (browser)
        const testWebp = outputMime === 'image/webp';
        if (testWebp) {
          // check support quickly
          const testCanvas = document.createElement('canvas');
          if (!testCanvas.toBlob || !(testCanvas.toBlob && testCanvas.toBlob.toString().indexOf('image/webp') === -1)) {
            // just use jpeg if webp unsupported
            if (file.type === 'image/png' && qualityPercent <= 95) outputMime = 'image/jpeg';
          }
        }

        // Convert to blob with quality (for JPEG/WebP respects quality)
        canvas.toBlob(function(blob) {
          if (!blob) {
            console.warn('Compression failed');
            return;
          }
          if (currentCompressedURL) URL.revokeObjectURL(currentCompressedURL);
          currentCompressedBlob = blob;
          currentCompressedURL = URL.createObjectURL(blob);
          compressedPreview.src = currentCompressedURL;
          const compressedBytes = blob.size;
          const originalBytes = file.size;
          compressedSizeSpan.innerText = formatBytes(compressedBytes);
          const savedPercent = ((originalBytes - compressedBytes) / originalBytes * 100).toFixed(1);
          let savingText = `↓ saved ${savedPercent}%`;
          if(savedPercent < 0) savingText = `↑ increased ${Math.abs(savedPercent)}% (try lower quality)`;
          savingRatioSpan.innerText = savingText;
          previewContainer.style.display = 'flex';
          noImageMessage.style.display = 'none';
        }, outputMime, qualityRatio);
      };
      img.onerror = () => {
        URL.revokeObjectURL(objectUrl);
        alert('Error loading image');
      };
      img.src = objectUrl;
    }

    function formatBytes(bytes) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    // download compressed
    downloadBtn.addEventListener('click', () => {
      if (currentCompressedBlob && currentOriginalFile) {
        let ext = '.jpg';
        if (currentCompressedBlob.type === 'image/png') ext = '.png';
        else if (currentCompressedBlob.type === 'image/webp') ext = '.webp';
        else ext = '.jpg';
        const originalName = currentOriginalFile.name.split('.')[0] || 'compressed';
        const downloadLink = document.createElement('a');
        downloadLink.href = currentCompressedURL;
        downloadLink.download = `${originalName}_compressed_${qualitySlider.value}q${ext}`;
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
      } else {
        alert('No compressed image available. Upload an image first.');
      }
    });

    // file selection trigger
    uploadZone.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) handleFile(e.target.files[0]);
      fileInput.value = '';
    });
    // drag & drop
    uploadZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadZone.style.background = '#f1f9ff';
    });
    uploadZone.addEventListener('dragleave', () => {
      uploadZone.style.background = '#fefefe';
    });
    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadZone.style.background = '#fefefe';
      const dt = e.dataTransfer;
      if (dt.files && dt.files[0]) handleFile(dt.files[0]);
    });

    // initial update label
    updateQualityLabel(qualitySlider.value);

    // clean object URLs on page exit
    window.addEventListener('beforeunload', () => {
      if (originalImageURL) URL.revokeObjectURL(originalImageURL);
      if (currentCompressedURL) URL.revokeObjectURL(currentCompressedURL);
    });

    // -------------------------------
    // GOOGLE ADSENSE DYNAMIC INSERTION with Ad Unit ID (monetization)
    // provide easy integration: user inputs AdSense client ID or full script snippet?
    // According to Google AdSense best practice: we can insert <ins> tag or script async.
    // We'll implement a function that injects standard AdSense code using given publisher id (ca-pub-xxx)
    // and optional ad slot. For simplicity, we will create an ad unit responsive.
    // The container #dynamicAdHolder will be cleared and replaced with AdSense code.
    function insertAdSense(publisherId, adSlotId = '') {
      const adContainer = document.getElementById('dynamicAdHolder');
      if (!adContainer) return;
      // Clear previous AdSense content;
      adContainer.innerHTML = '';
      // Build script tag for adsbygoogle
      if (!publisherId || publisherId.trim() === '') {
        adContainer.innerHTML = `<div style="font-size:12px; color:#a94442; background:#f9e6e6; padding:8px; border-radius:12px;">⚠️ Valid AdSense Publisher ID required (ca-pub-...).</div>`;
        return;
      }
      // Create ins element for responsive unit
      const insElem = document.createElement('ins');
      insElem.className = 'adsbygoogle';
      insElem.style.display = 'block';
      insElem.setAttribute('data-ad-client', publisherId.trim());
      if (adSlotId && adSlotId.trim() !== '') {
        insElem.setAttribute('data-ad-slot', adSlotId.trim());
      } else {
        // use a placeholder slot (user must replace or we provide default some generic)
        insElem.setAttribute('data-ad-slot', '1234567890');  // sample slot (replace via optional field)
      }
      insElem.setAttribute('data-ad-format', 'auto');
      insElem.setAttribute('data-full-width-responsive', 'true');
      adContainer.appendChild(insElem);
      
      // Load adsbygoogle script if not already loaded safely
      if (typeof window.adsbygoogle === 'undefined') {
        const script = document.createElement('script');
        script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js';
        script.async = true;
        script.crossOrigin = 'anonymous';
        script.onload = () => {
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch(e) { console.warn(e); }
        };
        document.head.appendChild(script);
      } else {
        try {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        } catch(e) { console.warn(e); }
      }
      const noteDiv = document.getElementById('adDebugNote');
      if(noteDiv) noteDiv.innerHTML = `✅ AdSense unit applied: ${publisherId}`;
    }

    // optionally user can also insert optional ad slot id (advanced)
    const applyAdBtn = document.getElementById('applyAdBtn');
    const adsenseIdInput = document.getElementById('adsenseIdInput');
    applyAdBtn.addEventListener('click', () => {
      let pubId = adsenseIdInput.value.trim();
      if (pubId && !pubId.startsWith('ca-pub-')) {
        alert('Publisher ID should start with "ca-pub-". Example: ca-pub-1234567890123456');
        return;
      }
      if (pubId === '') {
        document.getElementById('dynamicAdHolder').innerHTML = `<div style="padding:16px; background:#ffe6e6; border-radius:12px;">⚠️ No Publisher ID provided. Ad not loaded.</div>`;
        if(document.getElementById('adDebugNote')) document.getElementById('adDebugNote').innerHTML = '';
        return;
      }
      insertAdSense(pubId, '');  // you can extend optional slot field, but we keep simple
    });
    
    // small demo hint: optional prefill demo id? Not for production but to show concept
    const demoHint = document.createElement('div');
    // no sensitive default; but show guide
    const noteSpan = document.getElementById('adDebugNote');
    if(noteSpan) noteSpan.innerHTML = 'Enter your AdSense pub ID (ca-pub-...) and click Apply.';
  })();
</script>
</body>
</html>
